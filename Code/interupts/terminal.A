; ==========================================
; Terminal Interrupt Handler
; ==========================================

TERMINAL_IRQ:

    ; --------------------------------------
    ; Save registers that we modify
    ; --------------------------------------

    PUSH R1


    ; --------------------------------------
    ; Read character from terminal input
    ; --------------------------------------

    ; Terminal input port = 0
    MOVI R1, 0

    ; Read character into R14
    ;
    ; R14 is the dedicated terminal input
    ; register, so we deliberately DO NOT
    ; push/pop it.
    INP R14, R1


    ; --------------------------------------
    ; Output character to terminal
    ; --------------------------------------

    ; Terminal output port = 0
    OUT R1, R14


    ; --------------------------------------
    ; Restore registers
    ; --------------------------------------

    POP R1


    ; --------------------------------------
    ; Return from interrupt
    ;
    ; IRET restores:
    ;   FLAGS
    ;   PC
    ; and re-enables interrupts
    ; --------------------------------------

    IRET