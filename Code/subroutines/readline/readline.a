; ==========================================
; READLINE
;
; Reads a line from the terminal into a
; null-terminated buffer.
;
; Input:
;   R0  = buffer address
;   R14 = terminal input character
;
; Output:
;   R0  = address immediately after '\0'
;   R14 = 0
;
; Behaviour:
;   - Waits for a character in R14
;   - Stores characters into the buffer
;   - Enter (ASCII 10) terminates the line
;   - Adds a null terminator
;
; The terminal interrupt handler is responsible
; for reading and echoing the character.
; ==========================================

READLINE:

WAIT:
    ; Wait for terminal input
    MOVI R1, 0
    CMP R14, R1
    JE WAIT

    ; Check for Enter
    MOVI R1, 10
    CMP R14, R1
    JE DONE

    ; Store character in buffer
    STOREBIND R0, R14

    ; Advance buffer
    INC R0

    ; Mark R14 as consumed
    MOVI R14, 0

    JMP WAIT


DONE:
    ; Null terminate string
    MOVI R1, 0
    STOREBIND R0, R1

    ; Mark Enter as consumed
    MOVI R14, 0

    RET