READLINE:
    MOVI R1, 0          ; terminal port
    MOVI R3, 0          ; zero

READ_LOOP:
    INP R2, R1

    CMP R2, R3
    JE READ_LOOP        ; no input

    MOVI R4, 10
    CMP R2, R4
    JE READ_DONE

    MOVI R4, 8
    CMP R2, R4
    JE BACKSPACE

    MOVI R4, 127
    CMP R2, R4
    JE BACKSPACE

    STOREBIND R0, R2
    OUT R1, R2          ; echo character
    INC R0

    JMP READ_LOOP


BACKSPACE:
    ; handle backspace here
    JMP READ_LOOP


READ_DONE:
    STOREBIND R0, R3
    RET