; R0 = unsigned integer
; R1 = destination buffer
; R2-R7 = scratch
;
; Returns:
; R0 = number
; R1 = start of string

ITOA:
    MOV R7, R1

    ; -------------------------
    ; Handle zero
    ; -------------------------

    MOVI R2, 0
    CMP R0, R2
    JNE CONVERT

    MOVI R3, 48
    STOREBIND R1, R3
    INC R1

    MOVI R3, 0
    STOREBIND R1, R3

    MOV R1, R7
    RET


CONVERT:
    MOVI R4, 10

DIV_LOOP:
    MOVI R2, 0
    CMP R0, R2
    JE REVERSE

    DIV R3, R0, R4

    MUL R2, R3, R4
    SUB R2, R0, R2

    MOVI R5, 48
    ADD R2, R2, R5

    STOREBIND R1, R2
    INC R1

    MOV R0, R3

    JMP DIV_LOOP


REVERSE:
    MOV R6, R7
    DEC R1

REVERSE_LOOP:
    CMP R6, R1
    JG REVERSE_DONE

    LOADBIND R2, R6
    LOADBIND R3, R1

    STOREBIND R6, R3
    STOREBIND R1, R2

    INC R6
    DEC R1

    JMP REVERSE_LOOP


REVERSE_DONE:
    ; R1 is now at/before the middle.
    ; R7 is always the beginning.

    MOV R1, R7

FIND_END:
    LOADBIND R2, R1
    MOVI R3, 0
    CMP R2, R3
    JE ITOA_DONE

    INC R1
    JMP FIND_END

ITOA_DONE:
    MOV R1, R7
    RET