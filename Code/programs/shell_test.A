; ==========================================
; SIMPLE SHELL
; ==========================================

.ORG 0x1000


; ==========================================
; SHELL
; ==========================================

SHELL:
    MOVI R0, PROMPT
    SYSCALL 0

    ; Read command into 0x2000
    MOVI R0, 0x2000
    SYSCALL 4

    ; Check whether command is empty
    MOVI R2, 0x2000
    LOADBIND R3, R2
    MOVI R4, 0
    CMP R3, R4
    JE SHELL

    ; Check "help"
    MOVI R0, 0x2000
    MOVI R1, HELP
    CALL STRCMP

    MOVI R1, 0
    CMP R0, R1
    JE HELP_CMD

    ; Check "exit"
    MOVI R0, 0x2000
    MOVI R1, EXIT
    CALL STRCMP

    MOVI R1, 0
    CMP R0, R1
    JE EXIT_CMD

    ; Unknown command
    MOVI R0, UNKNOWN
    SYSCALL 0
    JMP SHELL


HELP_CMD:
    MOVI R0, HELP_TEXT
    SYSCALL 0
    JMP SHELL


EXIT_CMD:
    HALT


; ==========================================
; STRCMP
;
; R0 = string A
; R1 = string B
;
; Returns:
; R0 = 0 if equal
; R0 = 1 if different
;
; Uses:
; R2 = character A
; R3 = character B
; ==========================================

STRCMP:

CMP_LOOP:

    ; Load character from A
    LOADBIND R2, R0

    ; Load character from B
    LOADBIND R3, R1

    ; Compare characters
    CMP R2, R3

    ; Different?
    JNE CMP_DIFFERENT

    ; Are we at null terminator?
    MOVI R4, 0
    CMP R2, R4
    JE CMP_EQUAL

    ; Advance both strings
    INC R0
    INC R1

    JMP CMP_LOOP


CMP_EQUAL:

    MOVI R0, 0
    RET


CMP_DIFFERENT:

    MOVI R0, 1
    RET


; ==========================================
; STRINGS
; ==========================================

PROMPT:
    DB "> "
    DB 0

HELP:
    DB "help"
    DB 0

EXIT:
    DB "exit"
    DB 0

HELP_TEXT:
    DB "Commands-\n"
    DB "  help\n"
    DB "  exit\n"
    DB  0
UNKNOWN:
    DB "Unknown command\n"
    DB 0
