MOVI R0, 0x2000     ; R0 = buffer address
MOVI R1, 0          ; R1 = terminal port 0
MOVI R15, 10        ; R15 IS A NEW LINE

LOOP:
    INP R2, R1

    MOVI R3, 0
    CMP R2, R3
    JE LOOP          ; no input yet

    MOVI R3, 10
    CMP R2, R3
    JE PRINT         ; Enter

    STOREBIND R0, R2 ; store character
    OUT R1, R2       ; immediately echo character
    INC R0
    JMP LOOP


PRINT:
    MOVI R2, 0
    STOREBIND R0, R2 ; null terminate

    MOVI R0, 0x2000  ; reset to beginning of buffer


; -------------------------
; Print the string again
; -------------------------
OUT R1, R15 ; print a newline before echoing the text
PRINT1:
    LOADBIND R2, R0

    MOVI R3, 0
    CMP R2, R3
    JE DONE

    OUT R1, R2
    INC R0
    JMP PRINT1


DONE:
    MOVI R2, 10
    OUT R1, R2
    HALT