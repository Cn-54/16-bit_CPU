; ==========================================
; Terminal Input / String Echo Test
; ==========================================

.ORG 0x1000


; ------------------------------------------
; Initialisation
; ------------------------------------------

MOVI R0, 0x2000     ; R0 = buffer address
MOVI R1, 0          ; R1 = terminal output port
MOVI R15, 10        ; R15 = newline


; ==========================================
; Read input
; ==========================================

LOOP:

    ; R14 is set by the terminal interrupt
    ;
    ; Check if there is no character
    MOVI R2, 0
    CMP R14, R2
    JE LOOP


    ; --------------------------------------
    ; Check for Enter
    ; --------------------------------------

    MOVI R2, 10
    CMP R14, R2
    JE PRINT


    ; --------------------------------------
    ; Store character in buffer
    ; --------------------------------------

    STOREBIND R0, R14
    INC R0

    ; Clear input register
    MOVI R14, 0

    JMP LOOP


; ==========================================
; Print stored string
; ==========================================

PRINT:

    ; Clear input register
    MOVI R14, 0

    ; Null terminate string
    MOVI R2, 0
    STOREBIND R0, R2

    ; Reset buffer pointer
    MOVI R0, 0x2000


    ; --------------------------------------
    ; Print newline
    ; --------------------------------------

    OUT R1, R15


; ==========================================
; Print buffer
; ==========================================

PRINT1:

    LOADBIND R2, R0

    ; Check for null terminator
    MOVI R3, 0
    CMP R2, R3
    JE DONE

    ; Output character
    OUT R1, R2

    INC R0
    JMP PRINT1


; ==========================================
; Finished
; ==========================================

DONE:

    ; Print final newline
    OUT R1, R15

    HALT
